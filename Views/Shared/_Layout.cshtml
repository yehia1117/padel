<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Padel Club</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark nav-dark">
 <div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🎾 PADEL CLUB</a>
  <div class="d-flex gap-2 align-items-center">
   @if (User.Identity?.IsAuthenticated == true) {
      @if (User.IsInRole("Admin")) { <a class="btn btn-sm btn-outline-light" asp-controller="Admin" asp-action="Index">لوحة الإدارة</a> }
      else { <a class="btn btn-sm btn-outline-light" asp-controller="Booking" asp-action="Index">احجز ملعب</a><a class="btn btn-sm btn-outline-light" asp-controller="Booking" asp-action="MyBookings">حجوزاتي</a> }
      <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-light" type="submit">خروج</button></form>
   } else { <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">دخول</a><a class="btn btn-sm btn-green" asp-controller="Account" asp-action="Register">حساب جديد</a> }
  </div>
 </div>
</nav>
<main class="container py-4">
 @if (TempData["Message"] != null) { <div class="alert alert-info">@TempData["Message"]</div> }
 @RenderBody()
</main>
<footer class="text-center text-secondary py-4">Padel Club · حجز ملعب بادل</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
